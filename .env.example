APP_ENV=local
APP_ACCESS_CODE=
APP_SESSION_SECRET=
DATABASE_URL=sqlite+aiosqlite:///./tmp/audit_harness.db
WORKSPACE_ROOT=./tmp/audits
TEST_SUITE_CACHE_ROOT=./tmp/cache/test-suites
RECOVERY_MEMORY_ROOT=./tmp/cache/recovery
PROJECT_RECOVERY_HIGH_SUCCESS_COUNT=3
CROSS_RECOVERY_DEPOSIT_REPO_COUNT=3
CROSS_RECOVERY_DEPOSIT_SUCCESS_COUNT=5
CROSS_RECOVERY_MIDDLE_REPO_COUNT=3
CROSS_RECOVERY_MIDDLE_SUCCESS_COUNT=10
CROSS_RECOVERY_HIGH_REPO_COUNT=5
CROSS_RECOVERY_HIGH_SUCCESS_COUNT=20
RECOVERY_BASE_RETRY_COUNT=1
RECOVERY_HIGH_EXTRA_RETRY_COUNT=1
RECOVERY_HARD_MAX_ATTEMPTS=2
DEFAULT_TIMEOUT_SECONDS=300
SERVICE_STARTUP_TIMEOUT_SECONDS=30
MAX_LOG_CHARS=12000
MAX_PATCH_CHARS=200000
MAX_API_DOCUMENT_CHARS=200000
ENABLE_BACKGROUND_TASKS=true

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=app.log
ERROR_LOG_FILE_NAME=error.log
LOG_ROTATION_MODE=size
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=10
LOG_WHEN=midnight
LOG_INTERVAL=1
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_LLM_CONTENT=false
LOG_BODY_MAX_CHARS=8000

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0

SANDBOX_BACKEND=docker
SANDBOX_NETWORK=none
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_USER=1000:1000
DOCKER_API_TIMEOUT_SECONDS=600
DEPENDENCY_IMAGES_ENABLED=true
DEPENDENCY_BUILD_TIMEOUT_SECONDS=900
DEPENDENCY_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PYTHON_SANDBOX_IMAGE=audit-harness/python-basic:3.11
PYTHON_RUNTIME_IMAGES=3.10=audit-harness/python-basic:3.10,3.11=audit-harness/python-basic:3.11,3.12=audit-harness/python-basic:3.12
SANDBOX_ALLOWED_IMAGES=audit-harness/python-basic:3.10,audit-harness/python-basic:3.11,audit-harness/python-basic:3.12
